def load_libcups():
    candidate_names = [
        'libcupsimage.so.2',
        'libcups.so.2',
        'libcupsimage.so',
        'libcups.so',
        '/usr/lib/x86_64-linux-gnu/libcupsimage.so.2',
        '/usr/lib/x86_64-linux-gnu/libcups.so.2',
        '/usr/lib/aarch64-linux-gnu/libcups.so.2',
        '/usr/lib/i386-linux-gnu/libcups.so.2',
        '/usr/lib/libcupsimage.so.2',
        '/usr/lib/libcups.so.2',
        '/usr/lib64/libcupsimage.so.2',
        '/usr/lib64/libcups.so.2',
    ]
    for name in candidate_names:
        try:
            lib = ctypes.CDLL(name)
            if hasattr(lib, 'cupsRasterOpen'):
                return lib
        except OSError:
            pass
    for name in ('cupsimage', 'cups'):
        p = ctypes.util.find_library(name)
        if p:
            try:
                lib = ctypes.CDLL(p)
                if hasattr(lib, 'cupsRasterOpen'):
                    return lib
            except OSError:
                pass
    return None

def compute_deli_checksum(payload_bytes):
    """
    Computes the 32-bit unsigned byte-sum checksum required by the printer controller
    (for JPEG bands and JBIG1 pages):
      checksum = 0xFA + sum(4 little-endian length bytes) + sum(payload_bytes)
    """
    length = len(payload_bytes)
    len_sum = (
        (length & 0xFF)
        + ((length >> 8) & 0xFF)
        + ((length >> 16) & 0xFF)
        + ((length >> 24) & 0xFF)
    )
    return (0xFA + len_sum + sum(payload_bytes)) & 0xFFFFFFFF

def verify_jbig_bih(jbig_data, expected_w, expected_h):
    """
    Verifies that the 20-byte JBIG1 BIH header is single-layer sequential (DL=0, D=0)
    with P=1, L0=128, MX=8, MY=0, order=3, options=0x1c (28).
    """
    if not jbig_data or len(jbig_data) < 20:
        return False
    dl, d, planes, res_byte, xd, yd, l0, mx, my, order, options = struct.unpack(">BBBBIIIbbBB", jbig_data[:20])
    log(
        f"JBIG BIH: DL={dl} D={d} P={planes} XD={xd} YD={yd} "
        f"L0={l0} MX={mx} MY={my} order={order} options=0x{options:02x} (len={len(jbig_data)})"
    )
    if dl != 0 or d != 0 or planes != 1 or xd != expected_w or yd != expected_h or l0 != 128 or options != 0x1c:
        error(
            f"Invalid JBIG BIH parameters! Expected DL=0, D=0, P=1, XD={expected_w}, YD={expected_h}, "
            f"L0=128, options=0x1c; got DL={dl}, D={d}, P={planes}, XD={xd}, YD={yd}, L0={l0}, options=0x{options:02x}"
        )
        return False
    return True

def encode_jbig_ctypes(bitmap_bytes, width, height):
    """Primary JBIG1 encoder via libjbig.so.0 ctypes interface (single-layer D=0)."""
    candidate_names = [
        'libjbig.so.0',
        'libjbig.so',
        '/usr/lib/x86_64-linux-gnu/libjbig.so.0',
        '/usr/lib/x86_64-linux-gnu/libjbig.so',
        '/usr/lib/aarch64-linux-gnu/libjbig.so.0',
        '/usr/lib/i386-linux-gnu/libjbig.so.0',
        '/usr/lib/libjbig.so.0',
        '/usr/lib/libjbig.so',
        '/usr/lib64/libjbig.so.0',
        '/usr/lib64/libjbig.so',
    ]
    libjbig = None
    for name in candidate_names:
        try:
            libjbig = ctypes.CDLL(name)
            if hasattr(libjbig, 'jbg_enc_init'):
                break
        except OSError:
            libjbig = None
    if libjbig is None:
        p = ctypes.util.find_library('jbig')
        if p:
            try:
                libjbig = ctypes.CDLL(p)
            except OSError:
                libjbig = None
    if libjbig is None:
        return None

    try:
        CALLBACK = ctypes.CFUNCTYPE(None, ctypes.POINTER(ctypes.c_ubyte), ctypes.c_size_t, ctypes.c_void_p)
        chunks = []

        def data_out(start, length, _file_ptr):
            chunks.append(ctypes.string_at(start, length))

        cb = CALLBACK(data_out)
        state = ctypes.create_string_buffer(16384)
        buf = ctypes.create_string_buffer(bitmap_bytes, len(bitmap_bytes))
        plane_ptr = ctypes.cast(buf, ctypes.POINTER(ctypes.c_ubyte))
        planes = (ctypes.POINTER(ctypes.c_ubyte) * 1)(plane_ptr)

        libjbig.jbg_enc_init.argtypes = [
            ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_int,
            ctypes.POINTER(ctypes.POINTER(ctypes.c_ubyte)), CALLBACK, ctypes.c_void_p
        ]
        libjbig.jbg_enc_options.argtypes = [
            ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_ulong, ctypes.c_int, ctypes.c_int
        ]
        libjbig.jbg_enc_out.argtypes = [ctypes.c_void_p]
        libjbig.jbg_enc_free.argtypes = [ctypes.c_void_p]

        # Single resolution layer (D=0, DL=0), order=3 (ILEAVE|SMID), options=0x1c (28 = TPDON|TPBON|DPON), l0=128, mx=8, my=0
        libjbig.jbg_enc_init(state, width, height, 1, planes, cb, None)
        libjbig.jbg_enc_options(state, 3, 0x1c, 128, 8, 0)
        libjbig.jbg_enc_out(state)
        libjbig.jbg_enc_free(state)
        result = b"".join(chunks)
        if verify_jbig_bih(result, width, height):
            return result
        return None
    except Exception as e:
        log(f"libjbig ctypes error: {e}")
        return None

def encode_jbig(raw_bytes, width, height):
    """
    Compresses a 1-bit bitmap (where 0 = white background, 1 = black toner dot)
    into a Deli-compatible single-layer JBIG1 BIE stream.
    """
    res = encode_jbig_ctypes(raw_bytes, width, height)
    if res:
        return res

    log("libjbig.so.0 not available, falling back to pbmtojbg -q -o 3 -p 28 -s 128")
    pbm_header = f"P4\n{width} {height}\n".encode('ascii')
    pbm_payload = pbm_header + raw_bytes
    try:
        proc = subprocess.Popen(
            ['pbmtojbg', '-q', '-o', '3', '-p', '28', '-s', '128', '-'],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )
        stdout, stderr = proc.communicate(pbm_payload)
        if proc.returncode == 0 and verify_jbig_bih(stdout, width, height):
            return stdout
        error(f"pbmtojbg failed (code {proc.returncode}): {stderr.decode('utf-8', 'ignore').strip()}")
    except Exception as e:
        error(f"pbmtojbg invocation failed: {e}")

    error("All JBIG compression methods failed.")
    return None


