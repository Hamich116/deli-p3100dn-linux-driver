#!/usr/bin/env python3
"""
CUPS raster filter for Deli P3100DN / P3100DW / M3100 series laser printers.
PCL-XL / Deli Enhanced XL=1.2 protocol filter for CUPS (v1.0 Dual-Engine):
  - Simplex (1-sided) jobs use Engine A:
    1-bit full-page single-layer JBIG1 compression (ColorDepth=0 / e1Bit, \xC0\x00\xF8\x34).
  - Duplex (2-sided) jobs use Engine B:
    8-bit 256-line Deli-JPEG band compression (ColorDepth=2 / e8Bit, \xC0\x01\xF8\x35 or \xC0\x00\xF8\x35).
    Note: Deli P3100DN hardware controller requires 8-bit 256-line Deli-JPEG
    band compression whenever DuplexPageMode (\xF8\x35) is active.
"""

import sys
import os
import io
import ctypes
import ctypes.util
import struct
import subprocess

def log(msg):
    sys.stderr.write(f"DEBUG: [rastertodeli] {msg}\n")
    sys.stderr.flush()

def error(msg):
    sys.stderr.write(f"ERROR: [rastertodeli] {msg}\n")
    sys.stderr.flush()

