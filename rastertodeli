# Invert table for 1-bit/8-bit pixels (0xFF -> 0x00, 0x00 -> 0xFF)
INV_TABLE = bytes.maketrans(bytes(range(256)), bytes(255 - i for i in range(256)))

# Lookup table to expand 1 byte (8 bits, where 0=white, 1=black) into 8 grayscale bytes
# (where 0xFF=white paper, 0x00=black toner)
BIT_TO_GRAY8_LUT = [
    bytes(0x00 if (b & (0x80 >> bit)) else 0xFF for bit in range(8))
    for b in range(256)
]

